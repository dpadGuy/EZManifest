<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="EZManifest.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:EZManifest">
    <Application.Resources>
        <!-- Overrides must live inside XamlControlsResources.MergedDictionaries
             or ContentDialog size keys stay at WinUI defaults (tall/wide empty dialogs). -->
        <controls:XamlControlsResources>
            <controls:XamlControlsResources.MergedDictionaries>
                <ResourceDictionary>
                    <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
                    <x:Double x:Key="ContentDialogMinWidth">320</x:Double>
                    <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
                </ResourceDictionary>
            </controls:XamlControlsResources.MergedDictionaries>
        </controls:XamlControlsResources>
    </Application.Resources>
</Application>
