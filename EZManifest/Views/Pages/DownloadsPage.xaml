<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EZManifest.Views.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:EZManifest.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid
            x:Name="DownloadsRoot"
            Padding="10"
            AllowDrop="True"
            DragEnter="ManifestDropZone_DragEnter"
            DragOver="ManifestDropZone_DragOver"
            DragLeave="ManifestDropZone_DragLeave"
            Drop="ManifestDropZone_Drop"
            Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <!-- Shown while downloads are active. -->
        <StackPanel
            x:Name="BrowseActivePanel"
            Margin="0,0,0,16"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="Collapsed">
            <Button
                MinHeight="40"
                Padding="20,10"
                Content="Browse manifests"
                Click="BrowseManifests_Click" />
            <Button
                x:Name="ActiveSourceButton"
                MinHeight="40"
                Padding="20,10"
                Content="DepotBox"
                Click="UseDepotBox_Click" />
        </StackPanel>

        <ScrollViewer
            x:Name="DownloadsScrollViewer"
            Grid.Row="1"
            AllowDrop="True"
            DragEnter="ManifestDropZone_DragEnter"
            DragOver="ManifestDropZone_DragOver"
            DragLeave="ManifestDropZone_DragLeave"
            Drop="ManifestDropZone_Drop"
            VerticalScrollBarVisibility="Auto"
            Background="Transparent">
            <ItemsControl ItemsSource="{x:Bind Downloads, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DownloadItem">
                        <Border
                            Margin="0,0,0,12"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border
                                            Width="140"
                                            Height="52"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            CornerRadius="4">
                                            <Image Source="{x:Bind IconSource, Mode=OneWay}" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind GameName, Mode=OneWay}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Status, Mode=OneWay}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind SizeProgressText, Mode=OneWay}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ProgressPercentText, Mode=OneWay}" />
                                </Grid>

                                <ProgressBar
                                    Grid.Row="1"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{x:Bind ProgressValue, Mode=OneWay}" />

                                <Grid Grid.Row="2">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ElapsedText, Mode=OneWay}" />
                                    <StackPanel
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button Content="Cancel" Command="{x:Bind CancelCommand, Mode=OneWay}" />
                                        <Button Content="{x:Bind PauseButtonText, Mode=OneWay}" Command="{x:Bind PauseCommand, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Covers the full page when empty (no leftover top gap from the browse row). -->
        <Border
            x:Name="EmptyDropPrompt"
            Grid.Row="0"
            Grid.RowSpan="2"
            AllowDrop="True"
            DragEnter="ManifestDropZone_DragEnter"
            DragOver="ManifestDropZone_DragOver"
            DragLeave="ManifestDropZone_DragLeave"
            Drop="ManifestDropZone_Drop"
            IsHitTestVisible="True"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="2"
            CornerRadius="8">
            <Grid>
                <StackPanel
                    x:Name="UpdateModeBanner"
                    Margin="32,10,32,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Spacing="6"
                    Visibility="Collapsed">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="22"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        Text="Game Update Mode" />
                    <TextBlock
                        MaxWidth="660"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Import your manifest by any means in order for EZManifest to check for latest update of the game." />
                    <TextBlock
                        x:Name="UpdateModeGameText"
                        MaxWidth="560"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                    <Button
                        HorizontalAlignment="Center"
                        MinHeight="36"
                        Margin="0,8,0,0"
                        Padding="20,8"
                        Content="Cancel update"
                        Click="CancelUpdateMode_Click" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="16">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xF012;"
                            FontSize="36"
                            Opacity="0.85" />
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE8B7;"
                            FontSize="36"
                            Opacity="0.85" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <Button
                            HorizontalAlignment="Stretch"
                            MinHeight="44"
                            Padding="28,12"
                            FontSize="15"
                            Content="Browse manifests"
                            Click="BrowseManifests_Click" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            FontSize="12"
                            TextWrapping="WrapWholeWords"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Multiple .zip files or folders (picker or drag and drop)" />
                        <Button
                            x:Name="EmptySourceButton"
                            HorizontalAlignment="Stretch"
                            MinHeight="44"
                            Margin="0,8,0,0"
                            Padding="28,12"
                            FontSize="15"
                            Content="Use DepotBox instead"
                            Click="UseDepotBox_Click" />
                    </StackPanel>
                    <TextBlock
                        x:Name="DropZoneHint"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        FontSize="12"
                        TextWrapping="WrapWholeWords"
                        Visibility="Collapsed"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Drop .zip archives or folders here&#x0a;Each must contain a .lua file" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            x:Name="DropHighlightOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            IsHitTestVisible="False"
            Visibility="Collapsed"
            BorderThickness="3"
            CornerRadius="8"
            Background="#220078D4"
            BorderBrush="#FF0078D4" />
        </Grid>

        <Grid
            x:Name="DepotBoxPanel"
            Visibility="Collapsed"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                Padding="10,8"
                ColumnSpacing="8"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="DepotBoxBackButton"
                    Width="36"
                    Height="32"
                    Padding="0"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Back"
                    Click="DepotBoxBack_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <Button
                    x:Name="DepotBoxForwardButton"
                    Grid.Column="1"
                    Width="36"
                    Height="32"
                    Padding="0"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Forward"
                    Click="DepotBoxForward_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72A;" FontSize="14" />
                </Button>
                <Button
                    x:Name="DepotBoxCloseButton"
                    Grid.Column="2"
                    Width="36"
                    Height="32"
                    Padding="0"
                    ToolTipService.ToolTip="Close DepotBox"
                    Click="DepotBoxClose_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="14" />
                </Button>
                <TextBox
                    x:Name="DepotBoxAddressBox"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    PlaceholderText="Enter an address"
                    KeyDown="DepotBoxAddressBox_KeyDown" />
                <Button
                    Grid.Column="4"
                    Content="Go"
                    Click="DepotBoxGo_Click"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <Grid
                x:Name="DepotBoxBrowserHost"
                Grid.Row="1">
                <WebView2
                    x:Name="DepotBoxBrowser"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </Grid>
        </Grid>
    </Grid>
</Page>
