<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EZManifest.Views.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:EZManifest.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Unloaded="Page_Unloaded">

    <Grid Padding="16,12,8,0">
        <ScrollViewer
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled">
            <ItemsRepeater
                x:Name="GamesGrid"
                Margin="0,0,16,0"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind FilteredApps, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <!-- Fill stretches cards across the full row so leftover right gutter disappears. -->
                    <UniformGridLayout
                        Orientation="Horizontal"
                        MinItemWidth="180"
                        MinRowSpacing="10"
                        MinColumnSpacing="10"
                        ItemsStretch="Fill"
                        ItemsJustification="Start" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:GameEntry">
                        <Border
                            Tag="{x:Bind}"
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            PointerPressed="Card_PointerPressed"
                            DoubleTapped="Card_DoubleTapped"
                            RightTapped="Card_RightTapped">
                            <Grid VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- Cover art defaults to Steam portrait 300×450 (2:3). -->
                                <Border
                                    Grid.Row="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    CornerRadius="8,8,0,0"
                                    SizeChanged="CoverArt_SizeChanged">
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Opacity="0.55"
                                            Text="No art"
                                            Visibility="{x:Bind NoArtVisibility}" />
                                        <Image
                                            Source="{x:Bind Image}"
                                            Stretch="Uniform"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind CoverArtVisibility}" />
                                    </Grid>
                                </Border>
                                <StackPanel
                                    Grid.Row="1"
                                    Padding="10,8,10,10"
                                    Spacing="6">
                                    <Grid Height="40" HorizontalAlignment="Stretch">
                                        <TextBlock
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            FontSize="{x:Bind TitleFontSize}"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name}"
                                            TextWrapping="WrapWholeWords"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="2"
                                            TextAlignment="Center" />
                                    </Grid>
                                    <Button
                                        Tag="{x:Bind}"
                                        HorizontalAlignment="Stretch"
                                        Content="{x:Bind PrimaryActionText}"
                                        Click="PrimaryActionButton_Click" />
                                </StackPanel>
                                <Border
                                    Grid.RowSpan="2"
                                    IsHitTestVisible="False"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Visibility="{x:Bind SelectionVisibility, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
