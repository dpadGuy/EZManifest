<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EZManifest.Views.Pages.PatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Padding="10,8"
            ColumnSpacing="8"
            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BackButton"
                Width="36"
                Height="32"
                Padding="0"
                IsEnabled="False"
                ToolTipService.ToolTip="Back"
                Click="BackButton_Click">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <Button
                x:Name="ForwardButton"
                Grid.Column="1"
                Width="36"
                Height="32"
                Padding="0"
                IsEnabled="False"
                ToolTipService.ToolTip="Forward"
                Click="ForwardButton_Click">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72A;" FontSize="14" />
            </Button>
            <TextBox
                x:Name="AddressBox"
                Grid.Column="2"
                VerticalAlignment="Center"
                PlaceholderText="Enter an address"
                KeyDown="AddressBox_KeyDown" />
            <Button
                x:Name="GoButton"
                Grid.Column="3"
                Content="Go"
                Click="GoButton_Click"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <Grid
            x:Name="BrowserHost"
            Grid.Row="1">
            <WebView2 x:Name="Browser" />
        </Grid>
    </Grid>
</Page>
