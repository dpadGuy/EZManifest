<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EZManifest.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:EZManifest.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Page.Resources>

    <Grid>
        <ScrollViewer Padding="24">
            <StackPanel Spacing="8" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock FontSize="30" FontWeight="SemiBold" Text="Settings ⚙️" />
                <TextBlock FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" Text="Theme 🎨" />

                <RadioButton
                    Content="Light"
                    GroupName="themeSelect"
                    Command="{x:Bind ViewModel.ChangeThemeCommand}"
                    CommandParameter="theme_light"
                    IsChecked="{x:Bind ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}" />
                <RadioButton
                    Content="Dark"
                    GroupName="themeSelect"
                    Command="{x:Bind ViewModel.ChangeThemeCommand}"
                    CommandParameter="theme_dark"
                    IsChecked="{x:Bind ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}" />

                <TextBlock
                    Margin="0,5,0,8"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Enter your download path:" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Content="Apply" Click="ApplyPathButton_Click" Style="{StaticResource AccentButtonStyle}" />
                    <TextBox
                        x:Name="DownloadPathTextBox"
                        Grid.Column="1"
                        MinWidth="420"
                        PlaceholderText="Enter your download path here..." />
                </Grid>

                <Button
                    HorizontalAlignment="Right"
                    Content="Browse"
                    Click="BrowseButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />

                <TextBlock
                    Margin="0,5,0,8"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="CDN region 🗺️" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Chooses which Steam content cell to query for download servers. Auto uses Steam's default list."
                    TextWrapping="WrapWholeWords" />
                <ComboBox
                    x:Name="CdnRegionComboBox"
                    MinWidth="360"
                    MaxDropDownHeight="420"
                    HorizontalAlignment="Left"
                    IsTextSearchEnabled="True"
                    SelectionChanged="CdnRegionComboBox_SelectionChanged" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            Margin="14"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" />
    </Grid>
</Page>
