<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EZManifest.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:EZManifest.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Page.Resources>

    <Grid>
        <ScrollViewer Padding="24">
            <StackPanel Spacing="8" MaxWidth="720" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <TextBlock FontSize="30" FontWeight="SemiBold" Text="Settings" />
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="30" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <TextBlock FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Text="Theme" />
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center" />
                </StackPanel>

                <RadioButton
                    Content="Light"
                    GroupName="themeSelect"
                    Command="{x:Bind ViewModel.ChangeThemeCommand}"
                    CommandParameter="theme_light"
                    IsChecked="{x:Bind ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}" />
                <RadioButton
                    Content="Dark"
                    GroupName="themeSelect"
                    Command="{x:Bind ViewModel.ChangeThemeCommand}"
                    CommandParameter="theme_dark"
                    IsChecked="{x:Bind ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Enter your download path" />
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;" FontSize="20" VerticalAlignment="Center" />
                </StackPanel>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Content="Apply" Click="ApplyPathButton_Click" Style="{StaticResource AccentButtonStyle}" />
                    <TextBox
                        x:Name="DownloadPathTextBox"
                        Grid.Column="1"
                        MinWidth="420"
                        PlaceholderText="Enter your download path here..." />
                </Grid>

                <Button
                    HorizontalAlignment="Right"
                    Content="Browse"
                    Click="BrowseButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="CDN region" />
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE707;" FontSize="20" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Chooses which Steam content cell to query for download servers. Auto uses Steam's default list."
                    TextWrapping="WrapWholeWords" />
                <ComboBox
                    x:Name="CdnRegionComboBox"
                    MinWidth="360"
                    MaxDropDownHeight="420"
                    HorizontalAlignment="Left"
                    IsTextSearchEnabled="True"
                    SelectionChanged="CdnRegionComboBox_SelectionChanged" />


                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Download concurrency" />
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE762;" FontSize="20" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="How many depot chunks to download at once (1–64). Higher can be faster on good connections; too high may cause CDN timeouts. Default is 16. Applies to new downloads."
                    TextWrapping="WrapWholeWords" />
                <Grid ColumnSpacing="12" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button
                        Content="Apply"
                        Click="ApplyChunksButton_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                    <TextBox
                        x:Name="MaxChunksTextBox"
                        Grid.Column="1"
                        PlaceholderText="16"
                        InputScope="Number" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Content="Restore default"
                        Click="RestoreChunksDefaultButton_Click" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Notifications" />
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA8F;" FontSize="20" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Show a Windows notification when a game finishes installing."
                    TextWrapping="WrapWholeWords" />
                <ToggleSwitch
                    x:Name="NotifyOnInstallToggle"
                    OnContent="On"
                    OffContent="Off"
                    Toggled="NotifyOnInstallToggle_Toggled" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Updates" />
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE895;" FontSize="20" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="EZManifest checks for the latest version and shows an update prompt if newer version is available."
                    TextWrapping="WrapWholeWords" />
                <ToggleSwitch
                    x:Name="CheckForUpdatesToggle"
                    OnContent="On"
                    OffContent="Off"
                    Toggled="CheckForUpdatesToggle_Toggled" />
                <Button
                    Content="Check now"
                    Click="CheckForUpdatesButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Orientation="Horizontal"
            Spacing="10"
            Margin="14"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom">
            <HyperlinkButton
                Content="GitHub"
                NavigateUri="https://github.com/dpadGuy/EZManifest"
                Padding="0"
                VerticalAlignment="Center" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}"
                VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
